// flx equivalent of data/parsetree_cases.ml: one example per parsetree
// constructor, in the same order. This is a *syntax proposal* — most of
// these forms have no parser support yet.
//
// Conventions, in order of authority:
// - tests/fold/Basic.fl (current reference): val/let split, `@` aliases,
//   `#A` variants, `{..p, x}` record update, `&t` type patterns, `!` for
//   unreachable, `exn`/`eff` pattern keywords, `mod`/`sig` for modules.
// - doc/design-review.md operator model: `~a?` optional labels, tight vs
//   loose spacing.
// - tests/fold/lispy.fl / parsetree.fl older proposals: labelled argument
//   forms `~(a as b = 1)`, `[A] :: T` polytypes, `let x <- op m` letops,
//   `type [a] :: ...` locally abstract types.
// - Invented here (no prior proposal): class language (`cls`, `csig`),
//   object types `#{ x : int }`, polymorphic variant types `{ #A | #B }`,
//   package types `(sig S)`, `new`, `init`, `override`.

// ====== payload ======

// [PStr of structure]

// TODO: attributes on expressions
// val e = [@attr val a = 1] 1;

// [PSig of signature]

// TODO: attributes on expressions
// val e = [@attr : val a : int] 1;

// [PTyp of core_type]

// TODO: attributes on expressions
// val e = [@attr : int -> int] 1;

// [PPat of pattern * expression option]

// TODO: attributes on expressions
// val e = [@attr ? [C _ & xs] ? x] 1;

// ====== core_type ======

// [Ptyp_any]

val e : _ = 1;

// [Ptyp_var of string]

val e : A = 1;

// [Ptyp_arrow of arg_label * core_type * core_type]

val e_arrow_1 : int -> string = fn _ -> "abc";
val e_arrow_2 : int -> string -> unit = fn _ _ -> ();
val e_arrow_3 : (~l: int) -> string = fn ~(l as _) -> "abc";
val e_arrow_4 : (~l?: int) -> unit -> string = fn ~(l? as _) () -> "abc";
val e_arrow_5 : int -> (string -> unit) -> bool = fn _ _ -> True;

// [Ptyp_tuple of (string option * core_type) list]

val ptyp_tuple_1 : (int, bool) = (1, True);
val ptyp_tuple_2 : (~l1: int, bool) = (~l1: 1, True);
val ptyp_tuple_3 : (~l1: int, ~l2: bool) = (~l1: 1, ~l2: True);

// [Ptyp_constr of Longident.t loc * core_type list]

val e : int = 1;
val e : option[int] = None;
val e : result[int, string] = Ok 1;

// [Ptyp_object of object_field list * closed_flag]

// TODO: object types
// val e : #{ x : int, y : string } = x;
// TODO: object types
// val e : #{ x : int, y : string, .. } = x;

// [Ptyp_class of Longident.t loc * core_type list]

// TODO: class types
// val e : #cls1 = x;
// TODO: class types
// val e : #cls2[int] = x;
// TODO: class types
// val e : #t[int, B] = x;

// [Ptyp_alias of core_type * string loc]

val ptyp_alias_1 : (A @ int) = x;
val ptyp_alias_2 : (A @ {> #A }) = x;

// [Ptyp_variant of row_field list * closed_flag * label list option]

val e : { #A } = #A;
val e : { #A | #B } = #A;
// TODO: closed variant bounds
// val e : {< #A | #B } = #A;
val e : {> #A | #B } = #A;
// TODO: closed variant bounds
// val e : {< #A | #B | #C > #A #B } = #A;
// TODO: variant row inheritance
// val e : { ..t1 } = #A;
// TODO: variant row inheritance
// val e : { ..t1 | #A } = #A;
val e : { #A int } = #A 1;
// TODO: conjunctive variant arguments
// val e : { #A int & option[bool] & string } = #A 1;
// TODO: conjunctive variant arguments
// val e : { #A & int } = #A;

// [Ptyp_poly of string loc list * core_type]

val e : [A] :: int = 1;
val e : [A, B] :: A -> int = x;

// [Ptyp_package of package_type]

// TODO: package types
// val e : (sig M.S) = x;

// [Ptyp_open of Longident.t loc * core_type]

// TODO: open types
// val e : M.(a) = x;

// [Ptyp_extension of extension]

// TODO: extension types
// val e : (%ext 1) = x;

// ====== pattern ======

// [Ppat_any]

match x { _ -> 1 };

// [Ppat_var of string loc]

match x { a -> 1 };

// [Ppat_alias of pattern * string loc]

match x { a @ 1 -> 1 };

// [Ppat_constant of constant]

match x { 1 -> 1 };

// [Ppat_interval of constant * constant]

match x { 'a'..'z' -> 1 };

// [Ppat_tuple of (string option * pattern) list * Asttypes.closed_flag]

match x { (a, b) -> 1 };
match x { (~l1, b) -> 1 };
match x { (~l1, ~l2) -> 1 };

// [Ppat_construct of Longident.t loc * (string loc list * pattern) option]

match x { None -> 1 };
match x { Some a -> 1 };

// [Ppat_variant of label * pattern option]

match x { #A -> 1 };
match x { #B a -> 1 };

// [Ppat_record of (Longident.t loc * pattern) list * closed_flag]

match x { { ~x, ~y } -> 1 };
match x { { x = x2, ~y } -> 1 };
match x { { ~x, _ } -> 1 };

// [Ppat_array of pattern list]

match x { {} -> 1 };
match x { {a, _} -> 1 };

// [Ppat_or of pattern * pattern]

match x { (a | a) -> 1 };

// [Ppat_constraint of pattern * core_type]

match x { (a : int) -> 1 };

// [Ppat_type of Longident.t loc]

match x { &t1 -> 1 };

// [Ppat_lazy of pattern]

val (lazy a) = lazy 1;

// [Ppat_unpack of string option loc]

val (mod _) = x;

match x { mod M -> 1 };

// [Ppat_exception of pattern]

match x { _ -> 1, exn err -> 2 };

// [Ppat_effect of pattern * pattern]

// match x { _ -> 1, eff My k -> 2 };

// [Ppat_extension of extension]

// TODO: extension patterns
// match x { (%ext 1) -> x };

// [Ppat_open of Longident.t loc * pattern]

match x { M.(a) -> x };

// ====== expression ======

// [Pexp_ident of Longident.t loc]

x;
M.a;
a.(A.B.x);

// [Pexp_constant of constant] [Pconst_integer of string * char option]

val e = 3;
val e = 3l;
val e = 3L;
val e = 3n;

// [Pexp_constant of constant] [Pconst_char of char]

val e = 'c';

// [Pexp_constant of constant] [Pconst_string of string * Location.t * string option]

val e = "abc";
// FIXME: raw string without delimiter is a lex error
// val e = {|abc|};
// FIXME: parses as a pipe list, not a raw string
// val e = {delim|abc|delim};

// [Pexp_constant of constant] [Pconst_float of string * char option]

// FIXME: no float literals in the lexer
// val e = 3.4;
// FIXME: no float literals in the lexer
// val e = 2e5;
// FIXME: no float literals in the lexer
// val e = 1.4e-4;

// [Pexp_let of rec_flag * value_binding list * expression]

let e = 1, x;

rec x = 1, x;

let e = 1, and y = 2, x + y;

rec x = 1, and y = 2, x + y;

// [Pexp_function of function_param list * type_constraint option * function_body]

fn x -> 1;
// TODO: return type constraints on fn
// fn x : int -> 1;
fn ~l -> 1;
fn ~(l as x2) -> 1;
fn ~o? -> 1;
fn ~(o = 1) -> 1;
fn ~(o as o2 = 1) -> 1;
// TODO: return type constraints on fn
// fn ~x ~(b as (b2 : int) = 2) c : int -> x;
fn (type t) -> 1;
fn (type t) a -> 1;
fn (type t u) -> 1;

fn { 0 -> 1, _ -> 2 };

fn x -> fn { 0 -> 1, _ -> 2 };

// [Pexp_apply of expression * (arg_label * expression) list]

f x;
f x y;
f ~x ~b?;
f ~(x = x2) ~b?;
f ~(x = 2 + 2) ~(b? = None);

// [Pexp_match of expression * case list]

match x { 1 -> 0, _ -> 1 };

// [Pexp_try of expression * case list]

try x { Not_found -> 0 };

try x { Not_found -> 1, Failure msg -> 0 };

// [Pexp_tuple of (string option * expression) list]

(1, True);
(~l1: 1, True, 'x');
(~l1: 1, ~l2: True);

// [Pexp_construct of Longident.t loc * expression option]

None;
Some 2;
More 2 'x' True;

// [Pexp_variant of label * expression option]

#A;
#B 23;

// [Pexp_record of (Longident.t loc * expression) list * expression option]

{ x = 1 };
{ ..r, x = 1 };
{ ..(f 1), x = 1 };

// [Pexp_field of expression * Longident.t loc]

r.a;
r.(X.a);

// [Pexp_setfield of expression * Longident.t loc * expression]

r.a := x;
r.(X.a) := x;

// [Pexp_array of expression list]

{};
{1, 2, 3};

// [Pexp_ifthenelse of expression * expression * expression option]

if a { 1 } else { 2 };
if a { if b { 1 } else { 2 } } else { 3 };

// [Pexp_sequence of expression * expression]

// FIXME: braces sequences currently map to arrays (see Basic.fl).
{ a; b };

{ a; b; c };

// [Pexp_while of expression * expression]

while True { 1 };

// [Pexp_for of pattern * expression * expression * direction_flag * expression]

for (x = 0 to 9) { 1 };

// [Pexp_constraint of expression * core_type]

(1 : int);

// [Pexp_coerce of expression * core_type option * core_type]

(x :> t2);
(x : t1 :> t2);

// [Pexp_send of expression * label loc]

obj#meth1;

// [Pexp_new of Longident.t loc]

new a;
new M.a;

// [Pexp_setinstvar of label loc * expression]

x <- 1;

// [Pexp_override of (label loc * expression) list]

#{ ..self, x = 1, y = 2 };

// [Pexp_letmodule of string option loc * module_expr * expression]

// TODO: structure items in expression blocks
// { mod M = {}; 1 };

// [Pexp_letexception of extension_constructor * expression]

// TODO: structure items in expression blocks
