// --- Pexp_match ---
match e { x -> x };
match e { 1 -> 0, x -> 1 };
match e { 1 -> 0, x @ 2 -> 1 };
match e { (1 | 2) -> 0, x -> 1 };
match (1 + a) { (1 | 2) -> 0, x -> 1 };

