// [Pstr_primitive of value_description]

external x : int -> int = "prim_stub";
external x : int -> int = "prim_stub" "prim_stub_native";

// [Pstr_type of rec_flag * type_declaration list]

type t = int;
type nonrec t = int;

type t1 = { A4 int },
and t2 = { B4 bool };

// [Pstr_typext of type_extension]

type t += Pstr_typext_1 bool;

// [Pstr_exception of type_exception]

exn Pstr_exception_1;
exn Pstr_exception_2 int string;

// [Pstr_module of module_binding]

mod Pstr_module_1 = {};

// [Pstr_recmodule of module_binding list]

// TODO: recursive modules
// mod rec M1 : S = {},
// and M2 : S = {};

// [Pstr_modtype of module_type_declaration]

sig Mt = {};

// [Pstr_open of open_declaration]

open M;
open! M.N;

open {
  val e = 1;
};

// [Pstr_class of class_declaration list]

// TODO: no class language support in the parser
// cls c = #{};
// @virtual cls c[A] = #{};
// 
// cls c1 = #{},
// and c2 = #{};

// [Pstr_class_type of class_type_declaration list]

// TODO: no class language support in the parser
// csig ct = #{};
// 
// csig ct1 = #{},
// and ct2 = #{};

// [Pstr_include of include_declaration]

include M;

include {
  val e = 1;
};

// [Pstr_attribute of attribute]

[@attr];
[@attr "payload"];

// [Pstr_extension of extension * attributes]

%ext;
// TODO: extensions with attributes and payload
// [@attr] %ext 1;

// [Pvc_constraint]

val e : int = 1;
val e : [A] :: A -> A = fn x -> x;
val e : type [a] :: a -> a = fn x -> x;

// [Pvc_coercion of {ground:core_type option; coercion:core_type }]

val e :> int = x;
val e : t1 :> t2 = x;

