(rule
 (deps Basic.fl)
 (action
  (with-stdout-to
   Basic_fl_actual.sexp
   (run %{bin:fl} -i fl -o sexp %{deps}))))

(rule
 (deps Basic.ml)
 (action
  (with-stdout-to
   Basic_ml_actual.sexp
   (run %{bin:fl} -i ml -o sexp %{deps}))))

(rule
 (alias runtest)
 (action
  (diff Basic_expected.sexp Basic_fl_actual.sexp)))

(rule
 (alias runtest)
 (action
  (diff Basic_expected.sexp Basic_ml_actual.sexp)))

