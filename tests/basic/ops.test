# Prefix

+a
    (+. a)

+ a
    (+_ a)

+ a b c
    (+_ (_ a b c))

x, + a b c
    (, x (+_ (_ a b c)))

+a b c
    (_ (+. a) b c)

x, +a b c
    (, x (_ (+. a) b c))

f +a
    (_ f (+. a))

f ~a ~b
    (_ f (~. a) (~. b))

f ~a ~b c
    (_ f (~. a) (~. b) c)

f ~(a + b) ~c
    (_ f (~. ((_) (_+_ a b))) (~. c))

~ f a ~ g b
    (_~_ (~_ (_ f a)) (_ g b))

~ ~ a
    (~_ (~_ a))

~ ~ a b
    (~_ (~_ (_ a b)))

~ ~a
    (~_ (~. a))

~ ~a b
    (~_ (_ (~. a) b))


# Postfix

a~
    (.~ a)

a ~
    (_~ a)

a~ b
    (_ (.~ a) b)

a~ b c
    (_ (.~ a) b c)

f a~
    (_ f (.~ a))

f a~ b
    (_ f (.~ a) b)

f a~ b~
    (_ f (.~ a) (.~ b))

f a~ b~ c
    (_ f (.~ a) (.~ b) c)

f (a + b)~ c~
    (_ f (.~ ((_) (_+_ a b))) (.~ c))

f (a + b)~ ~c ~d
    (_ f (.~ ((_) (_+_ a b))) (~. c) (~. d))

f a~ + b
    (_+_ (_ f (.~ a)) b)

f a ~
    (_~ (_ f a))

f a c ~
    (_~ (_ f a c))

f a ~ g b ~
    (_~_ (_ f a) (_~ (_ g b)))


# Infix

a ~ b
    (_~_ a b)

a ~ b + c
    (_~_ a (_+_ b c))

a~b
    (.~. a b)

f a~b
    (_ f (.~. a b))

f a~b x c~d
    (_ f (.~. a b) x (.~. c d))

a~b + c
    (_+_ (.~. a b) c)

f ~a~b ~c
    (_ f (~. (.~. a b)) (~. c))

a~ ~ ~b
    (_~_ (.~ a) (~. b))

a ~ ~ b
    (_~_ a (~_ b))

f a ~ ~ g b
    (_~_ (_ f a) (~_ (_ g b)))

a ~ ~ ~ b
    (_~_ a (~_ (~_ b)))


# Tight vs loose: attached operators bind above juxtaposition

f a+b c
    (_ f (.+. a b) c)

f a + b c
    (_+_ (_ f a) (_ b c))

a+b * c
    (_*_ (.+. a b) c)

a + b*c
    (_+_ a (.*. b c))

a+b + c
    (_+_ (.+. a b) c)

f x a=1 b=2
    (_ f x (.=. a 1) (.=. b 2))

a+ b
    (_ (.+ a) b)

a +b
    (_ a (+. b))


# Dot binds above the tight band

a.b+c
    (.+. (. a b) c)

a.b~c
    (.~. (. a b) c)

f a.b+1 c
    (_ f (.+. (. a b) 1) c)


# Separators are spacing-blind

a: b
    (_ (.: a) b)

a :b
    (_ a (:. b))

a. b
    (. a b)

a .b
    (. a b)

a |b
    (| a b)


# Negative numbers

-1 - 2
    (_-_ (-. 1) 2)

f -1
    (_ f (-. 1))

-1-2
    (-. (.-. 1 2))

- 1 - 2
    (_-_ (-_ 1) 2)


# Idioms: optional labels, variants, macro calls

f ~a?
    (_ f (~. (.? a)))

f ~a? b
    (_ f (~. (.? a)) b)

m! (x)
    (_ (.! m) ((_) x))

f #A x
    (_ f (#. A) x)

x = #sm
    (_=_ x (#. sm))
