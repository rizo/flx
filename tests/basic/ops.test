# Prefix

+a
    (+_ a)

+ a
    (+__ a)

+ a b c
    (+__ (_ a b c))

x, + a b c
    (, x (+__ (_ a b c)))

+a b c
    (_ (+_ a) b c)

x, +a b c
    (, x (_ (+_ a) b c))

f +a
    (_ f (+_ a))

f ~a ~b
    (_ f (~_ a) (~_ b))

f ~a ~b c
    (_ f (~_ a) (~_ b) c)

f ~(a + b) ~c
    (_ f (~_ ((_) (__+__ a b))) (~_ c))

~ f a ~ g b
    (__~__ (~__ (_ f a)) (_ g b))

~ ~ a
    (~__ (~__ a))

~ ~ a b
    (~__ (~__ (_ a b)))

~ ~a
    (~__ (~_ a))

~ ~a b
    (~__ (_ (~_ a) b))


# Postfix

a~
    (_~ a)

a ~
    (__~ a)

a~ b
    (_ (_~ a) b)

a~ b c
    (_ (_~ a) b c)

f a~
    (_ f (_~ a))

f a~ b
    (_ f (_~ a) b)

f a~ b~
    (_ f (_~ a) (_~ b))

f a~ b~ c
    (_ f (_~ a) (_~ b) c)

f (a + b)~ c~
    (_ f (_~ ((_) (__+__ a b))) (_~ c))

f (a + b)~ ~c ~d
    (_ f (_~ ((_) (__+__ a b))) (~_ c) (~_ d))

f a~ + b
    (__+__ (_ f (_~ a)) b)

f a ~
    (__~ (_ f a))

f a c ~
    (__~ (_ f a c))

f a + g b ~
    (__+__ (_ f a) (__~ (_ g b)))


# Infix

a ~ b
    (__~__ a b)

a ~ b + c
    (__+__ (__~__ a b) c)

a~b
    (_~_ a b)

f a~b
    (_ f (_~_ a b))

f a~(b)
    (_ f (_~_ a ((_) b)))

f a~b x c~d
    (_ f (_~_ a b) x (_~_ c d))

a~b + c
    (__+__ (_~_ a b) c)

f ~a~b ~c
    (_ f (~_ (_~_ a b)) (~_ c))

a~ ~ ~b
    (__~__ (_~ a) (~_ b))

a ~ ~ b
    (__~__ a (~__ b))

f a ~ ~ g b
    (__~__ (_ f a) (~__ (_ g b)))

a ~ ~ ~ b
    (__~__ a (~__ (~__ b)))


# Tight vs loose: attached operators bind above juxtaposition

f a+b c
    (_ f (_+_ a b) c)

f a + b c
    (__+__ (_ f a) (_ b c))

a+b * c
    (__*__ (_+_ a b) c)

a + b*c
    (__+__ a (_*_ b c))

a+b + c
    (__+__ (_+_ a b) c)

f x a=1 b=2
    (_ f x (_=_ a 1) (_=_ b 2))

a+ b
    (_ (_+ a) b)

a +b
    (_ a (+_ b))


# Dot binds above the tight band

a.b+c
    (_+_ (. a b) c)

a.b~c
    (_~_ (. a b) c)

f a.b+1 c
    (_ f (_+_ (. a b) 1) c)


# Separators are spacing-blind

a: b
    (_ (_: a) b)

a :b
    (_ a (:_ b))

a. b
    (. a b)

a .b
    (. a b)

a |b
    (| a b)


# Negative numbers

-1 - 2
    (__-__ (-_ 1) 2)

f -1
    (_ f (-_ 1))

-1-2
    (-_ (_-_ 1 2))

- 1 - 2
    (__-__ (-__ 1) 2)


# Idioms: optional labels, variants, macro calls

f ~a?
    (_ f (~_ (_? a)))

f ~a? b
    (_ f (~_ (_? a)) b)

m! a b
    (_ (_! m) a b)

f #A x
    (_ f (#_ A) x)

x = #sm
    (__=__ x (#_ sm))

a.(1 + 2).x
    (. a ((_) (__+__ 1 2)) x)

a[1]
    (_ a ([_] 1))
[1] a
    (_ ([_] 1) a)
