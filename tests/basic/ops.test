# Prefix

~a
    (~_ a)

~ a
    (~_ a)

~a b
    (_ (~_ a) b)

f ~a
    (_ f (~_ a))

f ~a ~b
    (_ f (~_ a) (~_ b))

f ~a ~b c
    (_ f (~_ a) (~_ b) c)

f ~(a + b) ~c
    (_ f (~_ ((_) (_+_ a b))) (~_ c))

~ f a
    (~_ (_ f a))

~ f a c
    (~_ (_ f a c))

~ f a ~ g b
    (_~_ (~_ (_ f a)) (_ g b))

~ ~ a
    (~_ (~_ a))

~ ~ a b
    (~_ (~_ (_ a b)))

~ ~a
    (~_ (~_ a))

~ ~a b
    (~_ (_ (~_ a) b))


# Postfix

a~
    (_~ a)

a ~
    (_~ a)

a~ b
    (_ (_~ a) b)

a~ b c
    (_ (_~ a) b c)

f a~
    (_ f (_~ a))

f a~ b
    (_ f (_~ a) b)

f a~ b~
    (_ f (_~ a) (_~ b))

f a~ b~ c
    (_ f (_~ a) (_~ b) c)

f (a + b)~ c~
    (_ f (_~ ((_) (_+_ a b))) (_~ c))

f (a + b)~ ~c ~d
    (_ f (_~ ((_) (_+_ a b))) (~_ c) (~_ d))

f a~ + b
    (_+_ (_ f (_~ a)) b)

f a ~
    (_~ (_ f a))

f a c ~
    (_~ (_ f a c))

f a ~ g b ~
    (_~_ (_ f a) (_~ (_ g b)))


# Infix

a ~ b
    (_~_ a b)

a~b
    (_~_ a b)

a~ ~ ~b
    (_~_ (_~ a) (~_ b))

a ~ ~ b
    (_~_ a (~_ b))

f a ~ ~ g b
    (_~_ (_ f a) (~_ (_ g b)))

a ~ ~ ~ b
    (_~_ a (~_ (~_ b)))
